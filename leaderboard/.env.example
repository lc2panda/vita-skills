# Cloudflare D1 配置
# 执行 `npx wrangler d1 create vita-leaderboard-db` 后获取
VITA_D1_DATABASE_ID=your_database_id_here

# Cloudflare KV 配置
# 执行 `npx wrangler kv:namespace create vita-cache` 后获取
VITA_KV_ID=your_kv_id_here

# 部署域名（部署后获得）
VITA_LEADERBOARD_URL=https://vita-leaderboard.your-subdomain.workers.dev
